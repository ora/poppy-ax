# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Base URL of Ora's API. Every result on poppy.ax (summary, scan trigger,
# sites list, check catalog) comes from here; poppy.ax has no backend of its own.
ORA_BASE_URL=https://ora.ai

# Service token that poppy.ax sends to Ora's API from the server. It is never
# sent to the browser. Ask the Ora team for one; keep it in env vars only.
ORA_SERVICE_TOKEN=replace-me

# Set to 1 to serve recorded responses from fixtures/ instead of calling Ora.
# Use it for tests, previews and offline work. 0 calls the real API.
# In fixture mode, a check replays its recorded frames 30 ms apart; set
# ORA_FIXTURES_DELAY_MS to change that.
ORA_FIXTURES=0

# The id of a Vercel Firewall rate-limit rule (a rule with a @vercel/firewall
# condition, set in the Vercel dashboard) that limits checks per visitor IP.
# Leave it empty to use the built-in limit instead: 10 checks per minute per
# IP, counted on each server instance. The built-in limit is also used off
# Vercel and when the dashboard has no rule with this id.
POPPY_CHECK_RATE_LIMIT_ID=

# The site's own address, for canonical links and preview image URLs.
# Leave it unset in production (it defaults to https://poppy.ax); set it to
# a preview's address, or to http://poppy-ax.localhost:1355 locally.
NEXT_PUBLIC_SITE_URL=
