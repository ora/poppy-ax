{
  "name": "poppy-ax",
  "version": "0.1.0",
  "private": true,
  "description": "A plain-language guide to the Personal Agent Protocol (PAP), with a checker. An independent guide by Ora.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "command -v portless >/dev/null || npm install -g portless && portless run --name poppy-ax next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.8",
    "@vercel/analytics": "2.0.1",
    "@vercel/firewall": "1.2.5",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tldts": "7.4.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
